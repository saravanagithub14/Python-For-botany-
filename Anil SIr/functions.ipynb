    "def odd_even(num):\n",
    "    if num == 0:\n",
    "        print(\"zero is not even or odd \")\n",
    "    elif num%2 == 0:# if its even remider will be zero\n",
    "        print('its a even number')\n",
    "    else:\n",
    "        print(\"its an odd number\")"
   ]
